# Blocks Network API key — generated by: blocks login --write-env
BLOCKS_API_KEY=bk_...

# Local Ollama runtime (required for model-backed agents)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b

# Local SQLite database (required for luma-resources and luma-community)
DATABASE_URL="file:./dev.db"

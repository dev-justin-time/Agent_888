# Blocks Network API key — generated by: blocks login --write-env
BLOCKS_API_KEY=bk_...

# OpenAI API key (required for LLM-powered agents: navigator, escrow, outreach, all experts)
OPENAI_API_KEY=sk-...

# Postgres database (required for luma-resources and luma-community)
DATABASE_URL=postgresql://user:password@localhost:5432/lumanation?schema=public

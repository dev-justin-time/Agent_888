generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProviderType {
  navigator
  counselor
  peer
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  USER
  PROVIDER
  ADMIN
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  hashedPassword String    @map("hashed_password")
  role           UserRole  @default(USER)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  application ProviderApplication?

  @@map("users")
}

model Hotline {
  id        String   @id @default(cuid())
  locale    String   @unique
  name      String
  number    String
  text      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([locale])
  @@map("hotlines")
}

model Grant {
  id          String   @id @default(cuid())
  legacyId    String?  @unique @map("legacy_id")
  name        String
  description String
  amount      String
  coverage    String
  featured    Boolean  @default(false)
  rolling     Boolean  @default(false)
  tags        String[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([coverage])
  @@map("grants")
}

model Provider {
  id          String       @id @default(cuid())
  legacyId    String?      @unique @map("legacy_id")
  name        String
  locale      String
  type        ProviderType
  verified    Boolean      @default(false)
  cost        String
  description String
  tags        String[]
  founded     String?
  reach       String?
  image       String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([type])
  @@index([locale])
  @@map("providers")
}

model ProviderApplication {
  id          String            @id @default(cuid())
  userId      String            @unique @map("user_id")
  name        String
  type        ProviderType
  cost        String
  description String
  tags        String[]
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("provider_applications")
}

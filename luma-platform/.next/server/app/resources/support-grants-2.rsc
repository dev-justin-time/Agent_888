<!-- Hero Section -->
<section class="mb-section-gap">
<div class="flex items-center gap-4 mb-4">
<span class="material-symbols-outlined text-primary text-4xl" style="font-variation-settings: 'FILL' 1;">spa</span>
<h2 class="font-headline-lg text-headline-lg text-on-surface">Resources</h2>
</div>
<p class="text-on-surface-variant max-w-2xl leading-relaxed">
                Your sanctuary for immediate support and community growth. Access 24/7 help lines or explore our curated grants designed to foster local wellness and stability.
            </p>
</section>
<!-- Section 1: Hotlines -->
<section class="mb-section-gap">
<div class="flex justify-between items-end mb-6">
<div>
<h3 class="font-headline-md text-headline-md text-primary mb-1">Hotlines</h3>
<p class="text-on-surface-variant text-sm">Immediate, confidential support for any situation.</p>
</div>
</div>
<div class="grid gap-4">
<!-- Item: 24/7 Support -->
<div class="glass-card rounded-xl p-6 flex items-center justify-between group">
<div class="flex items-center gap-5">
<div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary">
<span class="material-symbols-outlined">call</span>
</div>
<div>
<h4 class="font-bold text-on-surface text-lg">24/7 Support Line</h4>
<p class="font-label-sm text-label-sm text-primary">1-800-555-HELP</p>
</div>
</div>
<button class="bg-primary hover:bg-primary-container text-on-primary px-6 py-2 rounded-full font-semibold transition-all duration-200 active:scale-95 shadow-lg shadow-primary/10">
                        Call Now
                    </button>
</div>
<!-- Item: Text Support -->
<div class="glass-card rounded-xl p-6 flex items-center justify-between group">
<div class="flex items-center gap-5">
<div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary">
<span class="material-symbols-outlined">sms</span>
</div>
<div>
<h4 class="font-bold text-on-surface text-lg">Text Support</h4>
<p class="font-label-sm text-label-sm text-primary">Text LUMA to 741741</p>
</div>
</div>
<button class="border border-primary/40 hover:bg-primary/5 text-primary px-6 py-2 rounded-full font-semibold transition-all duration-200 active:scale-95">
                        Send SMS
                    </button>
</div>
</div>
</section>
<!-- Featured Image Card -->
<div class="mb-section-gap h-48 rounded-2xl overflow-hidden relative glass-card border-none">
<div class="absolute inset-0 z-10 bg-gradient-to-r from-surface/80 to-transparent flex flex-col justify-center px-8">
<span class="text-xs font-label-sm text-primary uppercase tracking-widest mb-2">Community Spotlight</span>
<h3 class="font-headline-md text-headline-md text-on-surface max-w-xs">Building resilience together.</h3>
</div>
<div class="w-full h-full opacity-40 bg-cover bg-center" data-alt="An artistic rendering of a digital forest at twilight. Tall, slender trees made of soft green light pulse gently. The ground is covered in a glowing mist, and small firefly-like particles drift through the air. The overall mood is peaceful, safe, and atmospheric, utilizing deep emerald and teal tones consistent with the LumaNation design system." style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuBlCRRLV0p7PNk9UowpH2gK3HufFDFlRMqqVctVEOIEDZ9oL9EFalV_0tWkjKIQwbz-DsSMKNt3deQ92_gFFTQikORIt7powlqNldYo1QtJqt7hzBflz4V7rObTYXURRIO33VMDYC_K2-T4bAFnG8oe-igsNWaTXTHBty6JYZfxdVNYV5U9W0aknBsAzhkASnEcx4aCcdDT86NbZAyURrxTEbajChstjLJHhMN2GkKsh2HMYGS_-c6zRUEmBb8hbxHP3_WGtjU7qSLX')"></div>
</div>
<!-- Section 2: Grants -->
<section class="mb-section-gap">
<div class="flex justify-between items-end mb-6">
<div>
<h3 class="font-headline-md text-headline-md text-primary mb-1">Grants</h3>
<p class="text-on-surface-variant text-sm">Financial fuel for your initiatives and personal growth.</p>
</div>
<button class="text-primary font-label-sm text-label-sm hover:underline flex items-center gap-1">
                    View All <span class="material-symbols-outlined text-sm">arrow_forward</span>
</button>
</div>
<div class="grid md:grid-cols-2 gap-6">
<!-- Item: Community Wellness Grant -->
<div class="glass-card rounded-2xl p-8 flex flex-col h-full">
<div class="flex justify-between items-start mb-6">
<span class="bg-secondary-container/30 text-secondary px-3 py-1 rounded-full text-xs font-label-sm">Quarterly</span>
<span class="text-primary font-bold text-2xl font-headline-md">$5,000</span>
</div>
<h4 class="font-bold text-on-surface text-xl mb-3">Community Wellness Grant</h4>
<p class="text-on-surface-variant text-sm leading-relaxed mb-8 flex-grow">
                        Designed for grassroots projects that promote mental health awareness and shared sensory grounding experiences.
                    </p>
<button class="w-full py-4 bg-primary/10 hover:bg-primary/20 text-primary font-bold rounded-xl transition-all duration-200 flex items-center justify-center gap-2 group">
                        Apply Now
                        <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform">north_east</span>
</button>
</div>
<!-- Item: Stability Fund -->
<div class="glass-card rounded-2xl p-8 flex flex-col h-full">
<div class="flex justify-between items-start mb-6">
<span class="bg-secondary-container/30 text-secondary px-3 py-1 rounded-full text-xs font-label-sm">Emergency</span>
<span class="text-primary font-bold text-2xl font-headline-md">$2,500</span>
</div>
<h4 class="font-bold text-on-surface text-xl mb-3">Stability Fund</h4>
<p class="text-on-surface-variant text-sm leading-relaxed mb-8 flex-grow">
                        Direct financial support for members facing sudden transitions, ensuring food and housing security during recovery.
                    </p>
<button class="w-full py-4 bg-primary/10 hover:bg-primary/20 text-primary font-bold rounded-xl transition-all duration-200 flex items-center justify-center gap-2 group">
                        Learn More
                        <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform">north_east</span>
</button>
</div>
</div>
</section>
<!-- Informational Footer List -->
<section class="mt-section-gap pb-12 border-t border-white/5 pt-12">
<h4 class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-widest mb-6 text-center">Frequently Requested</h4>
<div class="space-y-2">
<div class="flex items-center justify-between p-4 rounded-xl hover:bg-surface-variant/20 transition-colors cursor-pointer">
<div class="flex items-center gap-4">
<span class="material-symbols-outlined text-on-surface-variant">description</span>
<span class="text-on-surface">Grant Application Guide</span>
</div>
<span class="material-symbols-outlined text-on-surface-variant text-sm">chevron_right</span>
</div>
<div class="flex items-center justify-between p-4 rounded-xl hover:bg-surface-variant/20 transition-colors cursor-pointer">
<div class="flex items-center gap-4">
<span class="material-symbols-outlined text-on-surface-variant">verified_user</span>
<span class="text-on-surface">Privacy &amp; Confidentiality Policy</span>
</div>
<span class="material-symbols-outlined text-on-surface-variant text-sm">chevron_right</span>
</div>
<div class="flex items-center justify-between p-4 rounded-xl hover:bg-surface-variant/20 transition-colors cursor-pointer">
<div class="flex items-center gap-4">
<span class="material-symbols-outlined text-on-surface-variant">volunteer_activism</span>
<span class="text-on-surface">Donate to the Stability Fund</span>
</div>
<span class="material-symbols-outlined text-on-surface-variant text-sm">chevron_right</span>
</div>
</div>
</section>

<!-- Hero Section -->
<section class="py-section-gap">
<div class="max-w-2xl">
<h1 class="font-display-lg text-display-lg text-on-surface mb-4">Finding Your Path</h1>
<p class="font-body-lg text-body-lg text-on-surface-variant">Access immediate support channels and community-funded grants designed to nurture your growth and sanctuary.</p>
</div>
</section>
<!-- Hotlines Section (Bento Grid) -->
<section class="mb-section-gap">
<div class="flex items-center gap-3 mb-8">
<span class="material-symbols-outlined text-primary">support_agent</span>
<h2 class="font-headline-md text-headline-md text-on-surface">Immediate Support</h2>
</div>
<div class="grid grid-cols-1 md:grid-cols-4 lg:grid-cols-6 gap-6">
<!-- Primary Hotline -->
<div class="md:col-span-2 lg:col-span-3 glass-card rounded-xl p-8 flex flex-col justify-between group">
<div>
<div class="flex justify-between items-start mb-6">
<span class="bg-primary/10 text-primary px-3 py-1 rounded-full font-label-sm text-label-sm">24/7 National</span>
<span class="material-symbols-outlined text-on-surface-variant/40">call</span>
</div>
<h3 class="font-headline-md text-headline-md text-on-surface mb-2">24/7 Support Line</h3>
<p class="font-body-md text-body-md text-on-surface-variant mb-8">A confidential, judgment-free space to talk whenever you need to be heard.</p>
</div>
<div class="flex items-center justify-between">
<span class="font-label-sm text-label-sm text-primary tracking-widest text-xl">1-800-LUMA-CARE</span>
<button class="w-12 h-12 rounded-full bg-primary flex items-center justify-center text-on-primary active:scale-90 transition-transform">
<span class="material-symbols-outlined">call</span>
</button>
</div>
</div>
<!-- Text Support -->
<div class="md:col-span-2 lg:col-span-3 glass-card rounded-xl p-8 flex flex-col justify-between border-l-4 border-l-primary/30">
<div>
<div class="flex justify-between items-start mb-6">
<span class="bg-primary/10 text-primary px-3 py-1 rounded-full font-label-sm text-label-sm">Instant Reply</span>
<span class="material-symbols-outlined text-on-surface-variant/40">sms</span>
</div>
<h3 class="font-headline-md text-headline-md text-on-surface mb-2">Text Support</h3>
<p class="font-body-md text-body-md text-on-surface-variant mb-8">Prefer typing? Connect with a trained empathetic listener through secure messaging.</p>
</div>
<div class="flex items-center justify-between">
<span class="font-label-sm text-label-sm text-primary tracking-widest text-xl">TEXT "HELLO" TO 741741</span>
<button class="w-12 h-12 rounded-full bg-surface-container-high border border-white/10 flex items-center justify-center text-primary active:scale-90 transition-transform">
<span class="material-symbols-outlined">send</span>
</button>
</div>
</div>
<!-- Specialized Lines -->
<div class="md:col-span-1 lg:col-span-2 glass-card rounded-xl p-6">
<span class="material-symbols-outlined text-tertiary mb-4">nature_people</span>
<h4 class="font-headline-md text-headline-md text-on-surface mb-2 text-lg">Youth Refuge</h4>
<p class="font-body-md text-body-md text-on-surface-variant mb-4">Dedicated support for individuals under 25.</p>
<span class="font-label-sm text-label-sm text-primary block">1-888-YOUTH-LUMA</span>
</div>
<div class="md:col-span-1 lg:col-span-2 glass-card rounded-xl p-6">
<span class="material-symbols-outlined text-tertiary mb-4">diversity_3</span>
<h4 class="font-headline-md text-headline-md text-on-surface mb-2 text-lg">Peer Network</h4>
<p class="font-body-md text-body-md text-on-surface-variant mb-4">Speak with someone who has walked your path.</p>
<span class="font-label-sm text-label-sm text-primary block">1-800-PEER-CONNECT</span>
</div>
<div class="md:col-span-2 lg:col-span-2 glass-card rounded-xl p-6 flex flex-col justify-center items-center text-center bg-primary/5 border-primary/20">
<p class="font-label-sm text-label-sm text-on-surface-variant mb-2">Emergency?</p>
<p class="font-headline-md text-headline-md text-error mb-4">Dial 988</p>
<p class="font-body-md text-body-md text-on-surface-variant/70 italic text-sm">For immediate crisis intervention</p>
</div>
</div>
</section>
<!-- Grants Section (Asymmetric Cards) -->
<section class="mb-section-gap">
<div class="flex items-center justify-between mb-8">
<div class="flex items-center gap-3">
<span class="material-symbols-outlined text-primary">volunteer_activism</span>
<h2 class="font-headline-md text-headline-md text-on-surface">Grants &amp; Funding</h2>
</div>
<button class="font-label-sm text-label-sm text-primary flex items-center gap-2 hover:opacity-80">
                    View All <span class="material-symbols-outlined text-sm">arrow_forward</span>
</button>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
<!-- Featured Grant -->
<div class="glass-card rounded-2xl overflow-hidden flex flex-col md:flex-row h-full">
<div class="md:w-1/2 h-48 md:h-auto relative">
<img class="w-full h-full object-cover" data-alt="A tranquil digital painting of a community garden at sunset, with soft green and golden light filtering through leaves. The style is impressionistic and organic, reflecting the 'Digital Forest' aesthetic of LumaNation. Deep emerald shadows and warm highlight colors." src="https://lh3.googleusercontent.com/aida-public/AB6AXuArAAf7GBKi1sniUBADQUbCKDR6XTsStUa39aXehJb-aLOe8luXz219_pRpUM_mukfG4FEazaxwD2B9Fua7O4r4TnfDgj-nAYry9t_jGTfzSNdnyF4-C6Hlfvuoe_ji7_LSlrYUZqxnp-KJRQpkXoTmYsVM3aZ9AtacXh17yu3ZUwO2ctK046epDFRfrUMQoym1BQOmoADOuQlulUAmwayzlePnoy5O1W-QfKVKO5KGDtqeq9XO7n7U3XFBscsZqTvlkUaLqgjyuELR"/>
<div class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent"></div>
</div>
<div class="p-8 md:w-1/2 flex flex-col justify-between bg-surface-container/20">
<div>
<span class="bg-secondary-container text-on-secondary-container px-3 py-1 rounded-full font-label-sm text-label-sm mb-4 inline-block">Featured</span>
<h3 class="font-headline-md text-headline-md text-on-surface mb-2">Community Wellness Grant</h3>
<p class="font-body-md text-body-md text-on-surface-variant mb-6">Funding local initiatives focused on emotional grounding and nature-based healing.</p>
</div>
<div class="flex items-end justify-between">
<div>
<p class="font-label-sm text-label-sm text-on-surface-variant">Up to</p>
<p class="font-display-lg text-display-lg text-primary text-3xl">$5,000</p>
</div>
<button class="bg-primary text-on-primary px-6 py-2 rounded-full font-label-sm text-label-sm active:scale-95 transition-transform">Apply</button>
</div>
</div>
</div>
<!-- Secondary Grant -->
<div class="glass-card rounded-2xl p-8 flex flex-col justify-between relative overflow-hidden">
<div class="absolute top-0 right-0 p-4 opacity-5 pointer-events-none">
<span class="material-symbols-outlined text-9xl">handshake</span>
</div>
<div>
<div class="flex items-center gap-2 mb-4">
<span class="material-symbols-outlined text-primary text-sm">check_circle</span>
<span class="font-label-sm text-label-sm text-on-surface-variant">Rolling Applications</span>
</div>
<h3 class="font-headline-md text-headline-md text-on-surface mb-2">Personal Growth Stipend</h3>
<p class="font-body-md text-body-md text-on-surface-variant mb-6">Small grants for individuals seeking professional counseling or therapeutic resources.</p>
</div>
<div class="flex items-end justify-between">
<div>
<p class="font-label-sm text-label-sm text-on-surface-variant">Awards of</p>
<p class="font-display-lg text-display-lg text-primary text-3xl">$750</p>
</div>
<button class="border border-primary text-primary px-6 py-2 rounded-full font-label-sm text-label-sm hover:bg-primary/5 active:scale-95 transition-transform">Learn More</button>
</div>
</div>
</div>
</section>
<!-- CTA / Footer Info -->
<section class="max-w-xl mx-auto text-center py-section-gap">
<p class="font-body-md text-body-md text-on-surface-variant italic">"In the heart of the forest, no one walks alone."</p>
<div class="mt-8 flex justify-center gap-4">
<div class="flex items-center gap-2 text-on-surface-variant/50">
<span class="material-symbols-outlined text-sm">lock</span>
<span class="font-label-sm text-label-sm">Secure Connection</span>
</div>
<div class="flex items-center gap-2 text-on-surface-variant/50">
<span class="material-symbols-outlined text-sm">encrypted</span>
<span class="font-label-sm text-label-sm">Privacy Guaranteed</span>
</div>
</div>
</section>

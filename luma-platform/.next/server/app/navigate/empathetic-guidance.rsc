2:T7f8,
<div class="max-w-3xl mx-auto flex flex-col space-y-gutter">
<!-- Date/Time Anchor -->
<div class="flex justify-center my-section-gap">
<span class="px-4 py-1 rounded-full bg-surface-container-high/40 text-on-surface-variant/60 font-label-sm text-label-sm border border-white/5">
                    Today's Sanctuary
                </span>
</div>
<!-- Luma Greeting -->
<div class="flex items-end gap-3 group">
<div class="w-8 h-8 rounded-full bg-primary-container/10 border border-primary/20 flex items-center justify-center shrink-0 mb-1 animate-float">
<span class="material-symbols-outlined text-primary scale-75" data-icon="auto_awesome" style="font-variation-settings: 'FILL' 1;">auto_awesome</span>
</div>
<div class="luma-bubble glass-panel px-6 py-4 rounded-[28px] max-w-[85%] text-on-surface transition-transform duration-300">
<p class="font-body-md text-body-md leading-relaxed">
                        Hello—I'm LumaNation. If you'd like, share a bit of what's on your mind and I'll offer a short, gentle story or small practice to steady you.
                    </p>
</div>
</div>
<!-- Example User Response (Initial State) -->
<div class="flex flex-col items-end gap-1 opacity-0 translate-y-4 animate-in duration-700 delay-300 fill-mode-forwards" id="initial-hint">
<span class="text-label-sm font-label-sm text-on-surface-variant/40 mr-4">Suggested</span>
<div class="flex gap-2 mr-2 overflow-x-auto scroll-hide max-w-full">
<button class="px-4 py-2 rounded-full border border-primary/20 bg-primary/5 text-primary text-label-sm font-label-sm whitespace-nowrap hover:bg-primary/10 transition-colors">
                        "I'm feeling overwhelmed"
                    </button>
<button class="px-4 py-2 rounded-full border border-primary/20 bg-primary/5 text-primary text-label-sm font-label-sm whitespace-nowrap hover:bg-primary/10 transition-colors">
                        "Just looking for peace"
                    </button>
</div>
</div>
<!-- Space for more messages -->
<div id="chat-anchor"></div>
</div>

<button class="px-6 py-2 rounded-full bg-surface-container text-on-surface-variant/80 border border-white/5 font-label-sm text-label-sm whitespace-nowrap hover:bg-surface-variant/50 transition-colors">Counseling</button>
<button class="px-6 py-2 rounded-full bg-surface-container text-on-surface-variant/80 border border-white/5 font-label-sm text-label-sm whitespace-nowrap hover:bg-surface-variant/50 transition-colors">Holistic</button>
<button class="px-6 py-2 rounded-full bg-surface-container text-on-surface-variant/80 border border-white/5 font-label-sm text-label-sm whitespace-nowrap hover:bg-surface-variant/50 transition-colors">Legal Aid</button>

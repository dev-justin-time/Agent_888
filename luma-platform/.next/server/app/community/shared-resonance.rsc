<!-- Hero Section -->
<section class="text-center space-y-4 max-w-2xl mx-auto">
<h2 class="font-display-lg text-display-lg text-primary leading-tight">Shared Resonance</h2>
<p class="font-body-lg text-body-lg text-on-surface-variant">Connecting you with verified sanctuaries and intentional communities beyond our digital borders.</p>
</section>
<!-- Provider Bento Grid -->
<section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
<!-- Provider Card 1: Healing Paths -->
<div class="glass-card rounded-[2rem] p-8 flex flex-col justify-between group">
<div class="space-y-6">
<div class="flex justify-between items-start">
<div class="bg-primary/10 p-4 rounded-2xl border border-primary/20">
<span class="material-symbols-outlined text-primary text-4xl">park</span>
</div>
<div class="flex flex-col items-end gap-2">
<span class="flex items-center gap-1 bg-surface-container-high px-3 py-1 rounded-full text-[10px] font-label-sm text-primary uppercase tracking-widest border border-primary/20 verified-pulse">
<span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">verified</span> Verified
                            </span>
<div class="flex items-center gap-1.5 bg-on-primary-container/20 px-3 py-1 rounded-full text-[10px] font-label-sm text-primary-fixed border border-primary-fixed/20">
<span class="material-symbols-outlined text-sm">shield_person</span> Zero-Record Privacy
                            </div>
</div>
</div>
<div class="space-y-3">
<h3 class="font-headline-md text-headline-md text-on-surface group-hover:text-primary transition-colors">Healing Paths</h3>
<p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">A holistic network specializing in forest therapy and somatic release. They focus on non-clinical, earth-based grounding techniques for emotional regulation.</p>
</div>
<div class="flex flex-wrap gap-2">
<span class="px-3 py-1 bg-secondary-container/30 text-secondary text-xs rounded-full border border-secondary-container/50">Nature-Based</span>
<span class="px-3 py-1 bg-secondary-container/30 text-secondary text-xs rounded-full border border-secondary-container/50">Somatic Therapy</span>
</div>
</div>
<div class="mt-8 pt-6 border-t border-white/5 flex justify-between items-center">
<span class="font-label-sm text-label-sm text-on-surface-variant/60">Founded 2018</span>
<a class="w-10 h-10 rounded-full bg-primary text-on-primary flex items-center justify-center transition-transform hover:scale-110 active:scale-90" href="#">
<span class="material-symbols-outlined">north_east</span>
</a>
</div>
</div>
<!-- Provider Card 2: OpenCare Collective -->
<div class="glass-card rounded-[2rem] p-8 flex flex-col justify-between group">
<div class="space-y-6">
<div class="flex justify-between items-start">
<div class="bg-tertiary/10 p-4 rounded-2xl border border-tertiary/20">
<span class="material-symbols-outlined text-tertiary text-4xl">diversity_1</span>
</div>
<div class="flex flex-col items-end gap-2">
<span class="flex items-center gap-1 bg-surface-container-high px-3 py-1 rounded-full text-[10px] font-label-sm text-primary uppercase tracking-widest border border-primary/20 verified-pulse">
<span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">verified</span> Verified
                            </span>
<div class="flex items-center gap-1.5 bg-on-primary-container/20 px-3 py-1 rounded-full text-[10px] font-label-sm text-primary-fixed border border-primary-fixed/20">
<span class="material-symbols-outlined text-sm">shield_person</span> Zero-Record Privacy
                            </div>
</div>
</div>
<div class="space-y-3">
<h3 class="font-headline-md text-headline-md text-on-surface group-hover:text-primary transition-colors">OpenCare Collective</h3>
<p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">Peer-led mutual aid sanctuary focused on deep listening and radical empathy. An open collective for those seeking communal support without hierarchies.</p>
</div>
<div class="flex flex-wrap gap-2">
<span class="px-3 py-1 bg-secondary-container/30 text-secondary text-xs rounded-full border border-secondary-container/50">Mutual Aid</span>
<span class="px-3 py-1 bg-secondary-container/30 text-secondary text-xs rounded-full border border-secondary-container/50">Peer Support</span>
</div>
</div>
<div class="mt-8 pt-6 border-t border-white/5 flex justify-between items-center">

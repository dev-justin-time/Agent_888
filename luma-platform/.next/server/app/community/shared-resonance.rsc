</div>
<div class="flex flex-wrap gap-2">
<span class="px-3 py-1 bg-secondary-container/30 text-secondary text-xs rounded-full border border-secondary-container/50">Science-Based</span>
<span class="px-3 py-1 bg-secondary-container/30 text-secondary text-xs rounded-full border border-secondary-container/50">Mindfulness</span>
</div>
</div>
<div class="mt-8 pt-6 border-t border-white/5 flex justify-between items-center">
<span class="font-label-sm text-label-sm text-on-surface-variant/60">Digital Sessions</span>
<a class="w-10 h-10 rounded-full bg-primary text-on-primary flex items-center justify-center transition-transform hover:scale-110 active:scale-90" href="#">
<span class="material-symbols-outlined">north_east</span>
</a>
</div>
</div>
<!-- Provider Card 4: Silent Space -->
<div class="glass-card rounded-[2rem] p-8 flex flex-col justify-between group">
<div class="space-y-6">
<div class="flex justify-between items-start">
<div class="bg-on-surface-variant/10 p-4 rounded-2xl border border-on-surface-variant/20">
<span class="material-symbols-outlined text-on-surface-variant text-4xl">notifications_off</span>
</div>
<div class="flex flex-col items-end gap-2">
<span class="flex items-center gap-1 bg-surface-container-high px-3 py-1 rounded-full text-[10px] font-label-sm text-primary uppercase tracking-widest border border-primary/20 verified-pulse">
<span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">verified</span> Verified
                            </span>
<div class="flex items-center gap-1.5 bg-on-primary-container/20 px-3 py-1 rounded-full text-[10px] font-label-sm text-primary-fixed border border-primary-fixed/20">
<span class="material-symbols-outlined text-sm">shield_person</span> Zero-Record Privacy
                            </div>
</div>
</div>
<div class="space-y-3">
<h3 class="font-headline-md text-headline-md text-on-surface group-hover:text-primary transition-colors">Silent Space</h3>
<p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">Curated physical retreat centers and quiet zones for digital detoxing. A network of non-tech sanctuaries across the continent.</p>
</div>
<div class="flex flex-wrap gap-2">
<span class="px-3 py-1 bg-secondary-container/30 text-secondary text-xs rounded-full border border-secondary-container/50">Physical Spaces</span>

{
  "name": "luma-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "blocks:login": "blocks login --write-env",
    "blocks:check": "cd blocks && for d in */; do (cd \"$d\" && blocks check) || exit 1; done",
    "blocks:register-all": "cd blocks && for d in */; do (cd \"$d\" && blocks register) || exit 1; done",
    "blocks:run": "node scripts/blocks.mjs run",
    "blocks:publish": "node scripts/blocks.mjs publish"
  },
  "dependencies": {
    "@blocks-network/sdk": "^0.1.0",
    "@neondatabase/serverless": "^0.10.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "lucide-react": "^0.344.0",
    "next": "^14.2.35",
    "next-auth": "^5.0.0-beta.25",
    "openai": "^4.28.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.17",
    "dotenv": "^16.4.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.35",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}

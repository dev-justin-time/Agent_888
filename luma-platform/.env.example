# Postgres database (Neon / Supabase / local PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/lumanation?schema=public

# NextAuth (Auth.js) v5 secret for JWT signing
NEXTAUTH_SECRET=your-nextauth-secret-at-least-32-chars
NEXTAUTH_URL=http://localhost:3000

# Standalone agent base URLs (used by Next.js API route proxies)
AGENT_NAVIGATOR_URL=http://localhost:8091
AGENT_RESOURCES_URL=http://localhost:8092
AGENT_COMMUNITY_URL=http://localhost:8093
AGENT_OUTREACH_URL=http://localhost:8094
AGENT_ESCROW_URL=http://localhost:8095

# OpenAI (used by standalone agents)
OPENAI_API_KEY=sk-...

# Optional admin user seeded on first run (role: ADMIN)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-admin-password

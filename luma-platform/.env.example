# Local data storage — SQLite file (no Postgres server needed)
# Relative to prisma/ — creates prisma/dev.db on first `prisma db push`
DATABASE_URL="file:./dev.db"

# NextAuth (Auth.js) v5 secret for JWT signing
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=your-nextauth-secret-at-least-32-chars
# NEXTAUTH_URL is OPTIONAL: the app sets `trustHost: true`, so the auth URL is
# derived from each request automatically (works for localhost and Vercel).
# Note: next-auth@5.0.0-beta.32 crashes with Next.js 14.1 when this var IS set
# (reqWithEnvURL constructs NextRequest) — leave it unset unless you must.
# NEXTAUTH_URL=http://localhost:3000

# Local LLM — Ollama (https://ollama.com). Start with `ollama serve`, then:
#   ollama pull llama3.2:3b
# Set OLLAMA_MODEL to the exact tag you pulled (check with `ollama list`).
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b

# Optional admin user seeded on first run (role: ADMIN)
ADMIN_EMAIL=admin@luma.local
ADMIN_PASSWORD=change-me

# Optional: Blocks Network key — only needed to publish/run the agents on
# blocks.ai. The app itself now runs fully locally without it.
BLOCKS_API_KEY=bk_...

# Optional rate limit tuning (in-memory only; use Redis/Vercel KV for multi-instance deployments)
# RATE_LIMIT_REGISTER_WINDOW_MS=3600000
# RATE_LIMIT_REGISTER_MAX=5
# RATE_LIMIT_CHAT_WINDOW_MS=60000
# RATE_LIMIT_CHAT_MAX=30
# RATE_LIMIT_EXPERT_WINDOW_MS=60000
# RATE_LIMIT_EXPERT_MAX=40

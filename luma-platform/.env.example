# Postgres database (Neon / Supabase / local PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/lumanation?schema=public

# NextAuth (Auth.js) v5 secret for JWT signing
NEXTAUTH_SECRET=your-nextauth-secret-at-least-32-chars
NEXTAUTH_URL=http://localhost:3000

# Blocks Network — the app calls the deployed Luma agents via the Blocks
# TaskClient (server-side only). Generate with: blocks login --write-env
BLOCKS_API_KEY=bk_...

# OpenAI (used by the LLM-powered Blocks agents: navigator, escrow, outreach, experts)
OPENAI_API_KEY=sk-...

# Optional admin user seeded on first run (role: ADMIN)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-admin-password

# Optional rate limit tuning (in-memory only; use Redis/Vercel KV for multi-instance deployments)
# RATE_LIMIT_REGISTER_WINDOW_MS=3600000
# RATE_LIMIT_REGISTER_MAX=5
# RATE_LIMIT_CHAT_WINDOW_MS=60000
# RATE_LIMIT_CHAT_MAX=30
# RATE_LIMIT_EXPERT_WINDOW_MS=60000
# RATE_LIMIT_EXPERT_MAX=40
